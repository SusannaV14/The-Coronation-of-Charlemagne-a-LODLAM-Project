                        <div class="zoom-illu" data-src="https://cdn.essentiels.bnf.fr/media/images/cache/cache/rc/0RxP9KSt/uploads/media/image/20201204051148000000_pas_2271.jpg" data-alt="Exemplaire sur papier des Grandes Chroniques de France">
            </div>
            <div class="zoom-navigation">
                <button type="button" class="cta cta-action zoom-btn zoom-in">
